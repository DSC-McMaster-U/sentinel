# Copy this file to .env and fill in local values. NEVER commit .env.
# Every value here is a safe placeholder. Variable names are proposals;
# owning workstreams may rename them (update this file in the same PR).

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Backend (FastAPI) ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- MCP server ----
MCP_SERVER_URL=http://localhost:8001/mcp

# ---- Frontend (Next.js) ----
# NEXT_PUBLIC_ values are exposed to the browser. Never put secrets in them.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Database (PostgreSQL), not used in Sprint 1 ----
DATABASE_URL=postgresql://sentinel:change-me@localhost:5432/sentinel

# ---- GitHub, not required in Sprint 1 (sample PR data is used) ----
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ---- LLM provider, not required in Sprint 1 (agents are mocked) ----
LLM_API_KEY=
